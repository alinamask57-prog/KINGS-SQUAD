* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body, html {
  width: 100%;
  height: 100%;
  overflow: hidden;
  font-family: 'Arial', sans-serif;
  background-color: #000;
}

canvas {
  display: block;
  width: 100vw;
  height: 100vh;
}

#ui-container {
  position: absolute;
  top: 20px;
  left: 20px;
  color: #fff;
  z-index: 10;
  pointer-events: none;
}

#speedometer {
  font-size: 28px;
  font-weight: bold;
  background: rgba(0, 0, 0, 0.6);
  padding: 10px 20px;
  border-radius: 8px;
  border: 1px solid #00ffcc;
  box-shadow: 0 0 10px rgba(0, 255, 204, 0.5);
  display: inline-block;
  margin-bottom: 10px;
}

#controls-info {
  background: rgba(0, 0, 0, 0.5);
  padding: 12px 18px;
  border-radius: 8px;
  font-size: 14px;
  line-height: 1.6;
}

#controls-info p b {
  color: #00ffcc;
}
